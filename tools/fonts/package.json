{
  "name": "@kithfield/fonts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fetches the embedded fonts from Google Fonts, verifies them and checks their Vietnamese coverage",
  "sideEffects": false,
  "scripts": {
    "download": "tsx src/fetch.ts",
    "verify": "tsx src/fetch.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kithfield/theme": "workspace:*"
  }
}
