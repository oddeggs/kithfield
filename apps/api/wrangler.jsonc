{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Two environments only: `--env dev` (Worker `kithfield-api-dev`) and `--env prd` (`kithfield-api`).
  // Bindings are not inherited, so each environment declares its own. Local runs and the tests use
  // `dev` with simulated bindings, which need no Cloudflare account.
  // Each environment owns `<host>/api/*` (prd `kithfield.com`, dev `dev.kithfield.com`); the website
  // serves the rest of the host.
  "name": "kithfield-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Node built-ins (crypto, buffer, async_hooks) for Better Auth and Sentry.
  "compatibility_flags": ["nodejs_compat"],
  // One FarmDO per farm or visit, one CottageDO per person; both keep their state in SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FarmDO", "CottageDO"] }],
  "env": {
    "dev": {
      "name": "kithfield-api-dev",
      "routes": [{ "pattern": "dev.kithfield.com/api/*", "zone_name": "kithfield.com" }],
      // Daily at 03:17 UTC: the waitlist's retention (unconfirmed rows, sent letters' addresses),
      // expired keepsakes exports, the safety desk's retention, the media sweep, and the purge of
      // accounts whose 30 days are over. Hourly at :07: the Sunday recap letters that are due in each
      // farm's time zone, and the AI's words owed a delete.
      "triggers": { "crons": ["17 3 * * *", "7 * * * *"] },
      // COMMIT_SHA is overridden at deploy time (`--var COMMIT_SHA:<sha>`).
      // Sign-in identity token audiences (public ids, not secrets).
      "vars": {
        "ENVIRONMENT": "dev",
        "SITE_ORIGIN": "https://dev.kithfield.com",
        "COMMIT_SHA": "local",
        "APPLE_BUNDLE_ID": "com.kithfield.app.dev",
        "GOOGLE_IOS_CLIENT_ID": "564934268570-n2lmcq3r3vc060p5hsankdnisfnalk0v.apps.googleusercontent.com",
        "GOOGLE_WEB_CLIENT_ID": "564934268570-hst5dob3msctegnpgskivamd25gh6jbc.apps.googleusercontent.com",
        // The safety desk sits behind Cloudflare Access: its JWTs are checked against the team's
        // certs and this environment's application audience. Who moderates, with their role, is
        // the `MODERATORS` secret.
        "ACCESS_TEAM_DOMAIN": "https://winstonb.cloudflareaccess.com",
        "ACCESS_AUD": "ab5c609924c99032dd023f45612a3a72153821ee9e74f4d98c4a83c0415dc41a",
        // Signed reads come from the media Worker on its own host (apps/media-worker).
        "MEDIA_ORIGIN": "https://media-dev.kithfield.com",
        "MEDIA_BUCKET_NAME": "kithfield-media-dev",
        // WeatherKit (the farm's daily weather): the team, the key's id and the Services ID its
        // tokens name. The key is the `WEATHERKIT_KEY` secret.
        "WEATHERKIT_TEAM_ID": "YFND2EEW8S",
        "WEATHERKIT_KEY_ID": "UC6TN76PKY",
        "WEATHERKIT_SERVICE_ID": "com.kithfield.app",
        // The farm rules version farms move to and start on: dev runs the newest rules.
        "RULES_TARGET": "4",
      },
      "durable_objects": {
        "bindings": [
          { "name": "FARM", "class_name": "FarmDO" },
          { "name": "COTTAGE", "class_name": "CottageDO" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kithfield-dev",
          "database_id": "465f2675-0691-48eb-b09d-4a890a82b349",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kithfield-media-dev" }],
      // Workers AI: voice-note captions, their translation and the Sunday recap letter. It always
      // runs on Cloudflare, also from `wrangler dev`; the tests stand in for it.
      "ai": { "binding": "AI", "remote": true },
      // Per-address limit on handing out sign-in nonces (keyed on cf-connecting-ip).
      "ratelimits": [
        {
          "name": "SIGN_IN_NONCE_LIMIT",
          "namespace_id": "1101",
          "simple": { "limit": 20, "period": 60 },
        },
        // Gestures at another farm's gate, per visitor.
        {
          "name": "GATE_LIMIT",
          "namespace_id": "1401",
          "simple": { "limit": 10, "period": 60 },
        },
        // Asking for the list of gates to visit, per person.
        {
          "name": "GATES_LIMIT",
          "namespace_id": "1259",
          "simple": { "limit": 30, "period": 60 },
        },
        // Upload URLs and forwarding copies, per person.
        {
          "name": "MEDIA_LIMIT",
          "namespace_id": "1253",
          "simple": { "limit": 60, "period": 60 },
        },
        // Per-address limit on waitlist sign-ups from the website (keyed on cf-connecting-ip).
        {
          "name": "WAITLIST_LIMIT",
          "namespace_id": "1201",
          "simple": { "limit": 5, "period": 60 },
        },
        // Per-address limit on account deletion requests and code tries from the website.
        {
          "name": "DELETION_REQUEST_LIMIT",
          "namespace_id": "1103",
          "simple": { "limit": 5, "period": 60 },
        },
        // Desktop sign-in by QR: codes asked per address, and codes looked up or answered per person.
        {
          "name": "DESKTOP_LINK_LIMIT",
          "namespace_id": "1105",
          "simple": { "limit": 10, "period": 60 },
        },
        // Reports and appeals from the app, per person.
        {
          "name": "REPORT_LIMIT",
          "namespace_id": "1251",
          "simple": { "limit": 10, "period": 60 },
        },
        // Asking for AI captions, per person and per farm.
        {
          "name": "AI_LIMIT",
          "namespace_id": "1255",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "AI_FARM_LIMIT",
          "namespace_id": "1257",
          "simple": { "limit": 120, "period": 60 },
        },
        // The shop's writes (purchase syncs, gifts, chip-ins, wall names), per person.
        {
          "name": "SHOP_LIMIT",
          "namespace_id": "1261",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      // Email Sending on kithfield.com (sign-in codes). `wrangler dev` simulates it and only logs.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@kithfield.com"] }],
      "queues": {
        "producers": [
          { "binding": "PUSH_QUEUE", "queue": "kithfield-push-dev" },
          { "binding": "MEDIA_QUEUE", "queue": "kithfield-media-jobs-dev" },
          { "binding": "AI_QUEUE", "queue": "kithfield-ai-dev" },
          { "binding": "DELETION_QUEUE", "queue": "kithfield-deletion-dev" },
        ],
        // A batch that keeps failing (3 retries by default) moves to its dead-letter queue.
        "consumers": [
          { "queue": "kithfield-push-dev", "dead_letter_queue": "kithfield-push-dlq-dev" },
          {
            "queue": "kithfield-media-jobs-dev",
            "dead_letter_queue": "kithfield-media-jobs-dlq-dev",
          },
          { "queue": "kithfield-ai-dev", "dead_letter_queue": "kithfield-ai-dlq-dev" },
          { "queue": "kithfield-deletion-dev", "dead_letter_queue": "kithfield-deletion-dlq-dev" },
        ],
      },
    },
    "prd": {
      "name": "kithfield-api",
      "routes": [{ "pattern": "kithfield.com/api/*", "zone_name": "kithfield.com" }],
      // Daily at 03:17 UTC: the waitlist's retention (unconfirmed rows, sent letters' addresses),
      // expired keepsakes exports, the safety desk's retention, the media sweep, and the purge of
      // accounts whose 30 days are over. Hourly at :07: the Sunday recap letters that are due in each
      // farm's time zone, and the AI's words owed a delete.
      "triggers": { "crons": ["17 3 * * *", "7 * * * *"] },
      // COMMIT_SHA is overridden at deploy time (`--var COMMIT_SHA:<sha>`).
      // Sign-in identity token audiences (public ids, not secrets).
      "vars": {
        "ENVIRONMENT": "prd",
        "SITE_ORIGIN": "https://kithfield.com",
        "COMMIT_SHA": "local",
        "APPLE_BUNDLE_ID": "com.kithfield.app",
        "GOOGLE_IOS_CLIENT_ID": "564934268570-jr7d94ci3jtb88sm4uqio1pjoatb3l31.apps.googleusercontent.com",
        "GOOGLE_WEB_CLIENT_ID": "564934268570-hst5dob3msctegnpgskivamd25gh6jbc.apps.googleusercontent.com",
        // The safety desk sits behind Cloudflare Access: its JWTs are checked against the team's
        // certs and this environment's application audience. Who moderates, with their role, is
        // the `MODERATORS` secret.
        "ACCESS_TEAM_DOMAIN": "https://winstonb.cloudflareaccess.com",
        "ACCESS_AUD": "e450f5c68897b3633d6cb8704171d85e3e17f6e82d4461dc519ab4a970ff81e6",
        // Signed reads come from the media Worker on its own host (apps/media-worker).
        "MEDIA_ORIGIN": "https://media.kithfield.com",
        "MEDIA_BUCKET_NAME": "kithfield-media",
        // WeatherKit (the farm's daily weather): the team, the key's id and the Services ID its
        // tokens name. The key is the `WEATHERKIT_KEY` secret.
        "WEATHERKIT_TEAM_ID": "YFND2EEW8S",
        "WEATHERKIT_KEY_ID": "UC6TN76PKY",
        "WEATHERKIT_SERVICE_ID": "com.kithfield.app",
        // The farm rules version farms move to and start on, held at what the store's phones read.
        "RULES_TARGET": "3",
      },
      "durable_objects": {
        "bindings": [
          { "name": "FARM", "class_name": "FarmDO" },
          { "name": "COTTAGE", "class_name": "CottageDO" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kithfield",
          "database_id": "5f18722b-a3a0-4e7b-8a17-bbf8f4f22a81",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kithfield-media" }],
      // Workers AI: voice-note captions, their translation and the Sunday recap letter.
      "ai": { "binding": "AI", "remote": true },
      // Per-address limit on handing out sign-in nonces (keyed on cf-connecting-ip).
      "ratelimits": [
        {
          "name": "SIGN_IN_NONCE_LIMIT",
          "namespace_id": "1102",
          "simple": { "limit": 20, "period": 60 },
        },
        // Gestures at another farm's gate, per visitor.
        {
          "name": "GATE_LIMIT",
          "namespace_id": "1402",
          "simple": { "limit": 10, "period": 60 },
        },
        // Asking for the list of gates to visit, per person.
        {
          "name": "GATES_LIMIT",
          "namespace_id": "1260",
          "simple": { "limit": 30, "period": 60 },
        },
        // Upload URLs and forwarding copies, per person.
        {
          "name": "MEDIA_LIMIT",
          "namespace_id": "1254",
          "simple": { "limit": 60, "period": 60 },
        },
        // Per-address limit on waitlist sign-ups from the website (keyed on cf-connecting-ip).
        {
          "name": "WAITLIST_LIMIT",
          "namespace_id": "1202",
          "simple": { "limit": 5, "period": 60 },
        },
        // Per-address limit on account deletion requests and code tries from the website.
        {
          "name": "DELETION_REQUEST_LIMIT",
          "namespace_id": "1104",
          "simple": { "limit": 5, "period": 60 },
        },
        // Desktop sign-in by QR: codes asked per address, and codes looked up or answered per person.
        {
          "name": "DESKTOP_LINK_LIMIT",
          "namespace_id": "1106",
          "simple": { "limit": 10, "period": 60 },
        },
        // Reports and appeals from the app, per person.
        {
          "name": "REPORT_LIMIT",
          "namespace_id": "1252",
          "simple": { "limit": 10, "period": 60 },
        },
        // Asking for AI captions, per person and per farm.
        {
          "name": "AI_LIMIT",
          "namespace_id": "1256",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "AI_FARM_LIMIT",
          "namespace_id": "1258",
          "simple": { "limit": 120, "period": 60 },
        },
        // The shop's writes (purchase syncs, gifts, chip-ins, wall names), per person.
        {
          "name": "SHOP_LIMIT",
          "namespace_id": "1262",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      // Email Sending on kithfield.com (sign-in codes). `wrangler dev` simulates it and only logs.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@kithfield.com"] }],
      "queues": {
        "producers": [
          { "binding": "PUSH_QUEUE", "queue": "kithfield-push" },
          { "binding": "MEDIA_QUEUE", "queue": "kithfield-media-jobs" },
          { "binding": "AI_QUEUE", "queue": "kithfield-ai" },
          { "binding": "DELETION_QUEUE", "queue": "kithfield-deletion" },
        ],
        // A batch that keeps failing (3 retries by default) moves to its dead-letter queue.
        "consumers": [
          { "queue": "kithfield-push", "dead_letter_queue": "kithfield-push-dlq" },
          { "queue": "kithfield-media-jobs", "dead_letter_queue": "kithfield-media-jobs-dlq" },
          { "queue": "kithfield-ai", "dead_letter_queue": "kithfield-ai-dlq" },
          { "queue": "kithfield-deletion", "dead_letter_queue": "kithfield-deletion-dlq" },
        ],
      },
    },
  },
}
