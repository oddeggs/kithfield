# Local secrets for `wrangler dev` (copy to .dev.vars, which git ignores). Names only.
# Deployed values are Wrangler secrets per environment: `wrangler secret put <NAME> --env <dev|prd>`.
# Each name added here is also added to `secretNames` in src/env.ts.
# Signs sessions and socket tokens; at least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Expo's enhanced push security; empty until it is turned on for the project.
EXPO_ACCESS_TOKEN=
