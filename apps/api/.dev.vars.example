# Local secrets for `wrangler dev` (copy to .dev.vars, which git ignores). Names only.
# Deployed values are Wrangler secrets per environment: `wrangler secret put <NAME> --env <dev|prd>`.
# Each name added here is also added to `secretNames` in src/env.ts.
# Signs sessions and socket tokens; at least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Expo's enhanced push security; empty until it is turned on for the project.
EXPO_ACCESS_TOKEN=
# Keys the waitlist's address hashes; at least 32 random characters (`openssl rand -base64 32`).
WAITLIST_EMAIL_KEY=
# Seals each farm's current invite code (AES-GCM); at least 32 random characters (`openssl rand -base64 32`).
INVITE_CODE_KEY=
# Signs the keepsakes export's download links; at least 32 random characters (`openssl rand -base64 32`).
EXPORT_URL_KEY=
# The safety desk's moderators as JSON, address → role (moderator, senior or legal), e.g.
# {"name@example.com":"senior"}. Cloudflare Access must let the same addresses in.
MODERATORS=
# Signs media read URLs and local upload-proxy PUTs; the same value goes to the media Worker
# (apps/media-worker). At least 32 random characters (`openssl rand -base64 32`).
MEDIA_SIGNING_KEY=
# R2's S3-compatible API for presigned uploads: the Cloudflare account id and an R2 API token
# (Object Read & Write on the media bucket). Left empty locally: `wrangler dev` has no S3 endpoint,
# so uploads go through the API's signed upload proxy instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The team's APNs key for Live Activity pushes: the whole `.p8` file's contents (PEM). Empty
# locally unless testing remote Live Activities on a device. Its id goes in the APNS_KEY_ID var.
APNS_KEY_P8=
