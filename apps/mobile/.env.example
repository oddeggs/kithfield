# Selects the app.config.ts variant: dev | prd. Unset means dev.
APP_VARIANT=dev
# The EAS project id (a UUID). Unset, the build has no over-the-air updates and is not linked to EAS.
EAS_PROJECT_ID=
# Points the app at another API, e.g. http://<this Mac's LAN address>:8787/api for `wrangler dev`.
# Unset means the variant's host (dev.kithfield.com or kithfield.com).
API_BASE=
