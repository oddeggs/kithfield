{
  "name": "@kithfield/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "web": "node web/copy-assets.mjs && expo start --web",
    "web:proxy": "node web/dev-proxy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@bacons/apple-targets": "catalog:",
    "@config-plugins/react-native-webrtc": "catalog:",
    "@expo/log-box": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@kithfield/art": "workspace:*",
    "@kithfield/contracts": "workspace:*",
    "@kithfield/farm": "workspace:*",
    "@kithfield/i18n": "workspace:*",
    "@kithfield/theme": "workspace:*",
    "@livekit/react-native": "catalog:",
    "@livekit/react-native-expo-plugin": "catalog:",
    "@livekit/react-native-webrtc": "catalog:",
    "@react-native-documents/viewer": "catalog:",
    "@react-native/metro-config": "catalog:",
    "@shopify/react-native-skia": "catalog:",
    "better-auth": "catalog:",
