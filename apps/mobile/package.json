{
  "name": "@kithfield/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/log-box": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@react-native/metro-config": "catalog:",
    "@shopify/react-native-skia": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-dev-client": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@jest/globals": "catalog:",
    "@react-native/jest-preset": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "expo-doctor": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
