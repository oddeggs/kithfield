  "devDependencies": {
    "@babel/core": "catalog:",
    "@jest/globals": "catalog:",
    "@react-native/jest-preset": "catalog:",
    "@types/react": "catalog:",
    "@types/sql.js": "catalog:",
    "babel-preset-expo": "catalog:",
    "expo-doctor": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
