    "expo-file-system": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-image": "catalog:",
    "expo-image-manipulator": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-linking": "catalog:",
    "expo-local-authentication": "catalog:",
    "expo-localization": "catalog:",
    "expo-location": "catalog:",
    "expo-media-library": "catalog:",
    "expo-network": "catalog:",
    "expo-notifications": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-sms": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
