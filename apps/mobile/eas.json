{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "dev",
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "env": { "APP_VARIANT": "dev" },
      "android": { "buildType": "apk" }
    },
    "dev": {
      "distribution": "store",
      "channel": "dev",
      "autoIncrement": true,
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "env": { "APP_VARIANT": "dev" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "autoIncrement": true,
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "environment": "preview",
      "env": { "APP_VARIANT": "prd", "API_BASE": "https://dev.kithfield.com/api" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    },
    "prd": {
      "distribution": "store",
      "channel": "prd",
      "autoIncrement": true,
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "env": { "APP_VARIANT": "prd" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    }
  },
  "submit": {
    "dev": {
      "ios": { "ascAppId": "6824232574" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    },
    "beta": {
      "ios": { "ascAppId": "6824232249" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    },
    "prd": {
      "ios": { "ascAppId": "6824232249" },
      "android": { "track": "production", "releaseStatus": "draft" }
    }
  }
}
