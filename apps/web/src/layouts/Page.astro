---
/**
 * A text page from `17 Website` (privacy, terms, support, deletion, contact): the brand and the
 * language switch at the top, then the page's column. On phones the side margins narrow.
 */
import Base from './Base.astro';
import { copyFor, facesFor, pathFor, type Language } from '../lib/site';

interface Props {
  lang: Language;
  path: string;
  title: string;
  /** Wider pages (the press kit) drop the 760 px column. */
  wide?: boolean;
  noindex?: boolean;
}
const { lang, path, title, wide = false, noindex = false } = Astro.props;
const t = copyFor(lang);
const f = facesFor(lang);
---

<Base lang={lang} path={path} title={`${title} · ${t('website.brand')}`} noindex={noindex}>
  <main
    class="kf-page"
    style={`padding:56px clamp(20px,8vw,72px) 60px;display:flex;flex-direction:column;gap:16px;${wide ? '' : 'max-width:760px'}`}
  >
    <header style="display:flex;align-items:center;gap:10px">
      <a
        href={pathFor(lang, '/')}
        style="display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none"
        ><kf-art scene="appicon" style="width:30px;height:30px;border-radius:8px;overflow:hidden"
        ></kf-art><span style={`font:400 19px/1 ${f.serif}`}>{t('website.brand')}</span></a
      >
      <span
        aria-label={t('website.languageLabel')}
        style="margin-left:auto;font:600 13px/1 -apple-system,system-ui;color:#6b5f55"
        ><a
          href={pathFor('en', path)}
          hreflang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
          style="color:inherit;text-decoration:none">EN</a
        > · <a
          href={pathFor('vi', path)}
          hreflang="vi"
          aria-current={lang === 'vi' ? 'page' : undefined}
          style="color:inherit;text-decoration:none">VI</a
        ></span
      >
    </header>
    <slot />
  </main>
</Base>
