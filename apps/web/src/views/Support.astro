---
/**
 * Support and FAQ. The search filters the questions as you type; a topic shows its own
 * questions. Answers open in place.
 */
import { pageStyles } from '../components/page/styles';
import Page from '../layouts/Page.astro';
import { copyFor, pathFor, type Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = copyFor(lang);
const s = pageStyles(lang);
const topics = [
  { id: 'farms', icon: 'farm', text: t('websitePages.support.farms') },
  { id: 'chats', icon: 'chat', text: t('websitePages.support.chats') },
  { id: 'fire', icon: 'lantern', text: t('websitePages.support.fire') },
  { id: 'plans', icon: 'seeds', text: t('websitePages.support.plans') },
  { id: 'patrons', icon: 'sparkle', text: t('websitePages.support.patrons') },
  { id: 'safety', icon: 'lock', text: t('websitePages.support.safety') },
];
const questions = [
  { topic: 'farms', q: t('websitePages.support.asleepQ'), a: t('websitePages.support.asleepA') },
  { topic: 'farms', q: t('websitePages.support.moveQ'), a: t('websitePages.support.moveA') },
  { topic: 'chats', q: t('websitePages.support.webQ'), a: t('websitePages.support.webA') },
  { topic: 'chats', q: t('websitePages.support.stickersQ'), a: t('websitePages.support.stickersA') },
];
---

<Page lang={lang} path="/support" title={t('websitePages.support.title')}>
  <style>
    .kf-faq summary {
      list-style: none;
      cursor: pointer;
    }
    .kf-faq summary::-webkit-details-marker {
      display: none;
    }
    .kf-faq[open] .kf-chev {
      transform: rotate(90deg);
    }
    .kf-topic[aria-pressed='true'] {
      box-shadow: inset 0 0 0 2px #5e7f4a;
    }
  </style>
  <h1 style={s.title}>{t('websitePages.support.title')}</h1>
  <label
    style="box-sizing:border-box;height:50px;border-radius:25px;background:#fffaf2;border:1px solid rgba(42,34,29,.14);display:flex;align-items:center;gap:8px;padding:0 18px"
  >
    <kf-art scene="icon" name="search" color="#857a70" style="width:18px;height:18px;flex:none;"
    ></kf-art>
    <span class="kf-sr">{t('websitePages.support.search')}</span>
    <input
      data-kf="faq-search"
      type="search"
      placeholder={t('websitePages.support.search')}
      style="flex:1;min-width:0;border:0;background:none;outline:none;font:15px/1 -apple-system,system-ui;color:#2a221d;padding:0"
    />
  </label>
  <div
    style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:10px"
  >
    {
      topics.map((topic) => (
        <button
          type="button"
          class="kf-topic"
          data-topic={topic.id}
          aria-pressed="false"
          style="display:flex;gap:12px;align-items:center;padding:14px 16px;border-radius:18px;background:#fffaf2;border:0;cursor:pointer;color:#2a221d;text-align:left"
        >
          <kf-art scene="icon" name={topic.icon} color="#2a221d" style="width:28px;height:28px;flex:none;" />
          <span style="font:600 15.5px/1.2 -apple-system,system-ui">{topic.text}</span>
        </button>
      ))
    }
  </div>
  <h2 style={s.heading}>{t('websitePages.support.popular')}</h2>
  <div data-kf="faq">
    {
      questions.map((item) => (
        <details class="kf-faq" data-topic={item.topic} style="border-bottom:1px solid rgba(42,34,29,.1)">
          <summary style="padding:12px 0;font:600 15.5px/1.3 -apple-system,system-ui;display:flex;justify-content:space-between;gap:12px">
            {item.q}
            <span class="kf-chev" aria-hidden="true" style="color:#6b5f55;transition:transform .2s">
              ›
            </span>
          </summary>
          <p style={`${s.body};padding:0 0 14px`}>{item.a}</p>
        </details>
      ))
    }
    <p data-kf="faq-empty" hidden style={`${s.body};padding:12px 0`}>
      {t('websitePages.support.empty')}
    </p>
  </div>
  <a href={pathFor(lang, '/contact')} style="color:#5E7F4A;font:600 15px/1 -apple-system,system-ui"
    >{t('websitePages.support.stuck')}</a
  >
</Page>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-kf="faq-search"]');
  const items = [...document.querySelectorAll<HTMLDetailsElement>('.kf-faq')];
  const topics = [...document.querySelectorAll<HTMLButtonElement>('.kf-topic')];
  const empty = document.querySelector<HTMLElement>('[data-kf="faq-empty"]');
  let topic: string | null = null;

  const show = (): void => {
    const words = (search?.value ?? '').trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const text = item.textContent?.toLocaleLowerCase() ?? '';
      const match =
        (topic === null || item.dataset.topic === topic) && words.every((w) => text.includes(w));
      item.hidden = !match;
      if (match) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  };
  search?.addEventListener('input', show);
  for (const button of topics) {
    button.addEventListener('click', () => {
      topic = topic === button.dataset.topic ? null : (button.dataset.topic ?? null);
      for (const other of topics) other.setAttribute('aria-pressed', String(other.dataset.topic === topic));
      show();
    });
  }
</script>
