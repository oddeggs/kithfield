---
/** Privacy, the house rules and the child safety standards: plain, dated text from the catalogue. */
import { pageStyles } from '../components/page/styles';
import Page from '../layouts/Page.astro';
import { contacts, copyFor, pathFor, type Language } from '../lib/site';

interface Props {
  lang: Language;
  page: 'privacy' | 'terms' | 'child-safety';
}
const { lang, page } = Astro.props;
const t = copyFor(lang);
const s = pageStyles(lang);
const LINK = '\u0000';

/** A section's text; where it says `LINK`, its link goes. */
interface Section {
  heading: string;
  body: string;
  link?: { href: string; text: string };
}

const safetyMail = { href: `mailto:${contacts.safety}`, text: contacts.safety };

const content: { title: string; lead: string; sections: Section[] } =
  page === 'privacy'
    ? {
        title: t('websitePages.privacy.title'),
        lead: t('websitePages.privacy.lead'),
        sections: [
          { heading: t('websitePages.privacy.keepTitle'), body: t('websitePages.privacy.keep') },
          { heading: t('websitePages.privacy.neverTitle'), body: t('websitePages.privacy.never') },
          {
            heading: t('websitePages.privacy.partnersTitle'),
            body: t('websitePages.privacy.partners'),
          },
          {
            heading: t('websitePages.privacy.waitlistTitle'),
            body: t('websitePages.privacy.waitlist'),
          },
          {
            heading: t('websitePages.privacy.choicesTitle'),
            body: t('websitePages.privacy.choices', { link: LINK }),
            link: {
              href: pathFor(lang, '/delete-account'),
              text: t('websitePages.privacy.onTheWeb'),
            },
          },
        ],
      }
    : page === 'terms'
      ? {
          title: t('websitePages.terms.title'),
          lead: t('websitePages.terms.lead'),
          sections: [
            {
              heading: t('websitePages.terms.kindTitle'),
              body: t('websitePages.terms.kind', { link: LINK }),
              link: {
                href: pathFor(lang, '/child-safety'),
                text: t('websitePages.terms.childSafetyLink'),
              },
            },
            {
              heading: t('websitePages.terms.purchasesTitle'),
              body: t('websitePages.terms.purchases'),
            },
            {
              heading: t('websitePages.terms.leavingTitle'),
              body: t('websitePages.terms.leaving'),
            },
          ],
        }
      : {
          title: t('websitePages.childSafety.title'),
          lead: t('websitePages.childSafety.lead'),
          sections: [
            {
              heading: t('websitePages.childSafety.neverTitle'),
              body: t('websitePages.childSafety.never'),
            },
            {
              heading: t('websitePages.childSafety.ageTitle'),
              body: t('websitePages.childSafety.age'),
            },
            {
              heading: t('websitePages.childSafety.reportTitle'),
              body: t('websitePages.childSafety.report', { email: LINK }),
              link: safetyMail,
            },
            {
              heading: t('websitePages.childSafety.actTitle'),
              body: t('websitePages.childSafety.act'),
            },
            {
              heading: t('websitePages.childSafety.scanTitle'),
              body: t('websitePages.childSafety.scan'),
            },
            {
              heading: t('websitePages.childSafety.contactTitle'),
              body: t('websitePages.childSafety.contact', { email: LINK }),
              link: safetyMail,
            },
          ],
        };
---

<Page lang={lang} path={`/${page}`} title={content.title}>
  <h1 style={s.title}>{content.title}</h1>
  <p style={s.body}>{content.lead}</p>
  {
    content.sections.map((section) => {
      const [before, after] = section.body.split(LINK);
      return (
        <>
          <h2 style={s.heading}>{section.heading}</h2>
          <p style={s.body}>
            {before}
            {after !== undefined && section.link !== undefined && (
              <>
                <a href={section.link.href} style="color:#5E7F4A">
                  {section.link.text}
                </a>
                {after}
              </>
            )}
          </p>
        </>
      );
    })
  }
</Page>
